# Copier vers .env.e2e avant le premier lancement E2E :
#   cp .env.e2e.example .env.e2e
# Ou utiliser : make e2e-up (génère .env.e2e automatiquement)

E2E_POSTGRES_USER=e2e
E2E_POSTGRES_PASSWORD=__CHANGE_ME__
E2E_POSTGRES_DB=medicote_e2e

E2E_JWT_SECRET=__CHANGE_ME__
E2E_JWT_REFRESH_SECRET=__CHANGE_ME__
E2E_ENCRYPTION_KEY=__CHANGE_ME__

E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001/api
E2E_PASSWORD=__CHANGE_ME__
