generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  emailVerified           DateTime?
  password                String?
  role                    UserRole
  status                  UserStatus               @default(PENDING_VERIFICATION)
  googleId                String?                  @unique
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  backupCodes             String[]
  lastLoginAt             DateTime?
  lastLoginIp             String?
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  auditLogs               AuditLog[]
  consents                Consent[]
  dataDeletionRequests    DataDeletionRequest[]
  dataExportRequests      DataExportRequest[]
  emailVerificationTokens EmailVerificationToken[]
  notificationPreference  NotificationPreference?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  patient                 Patient?
  practitioner            Practitioner?
  refreshTokens           RefreshToken[]
  sessions                Session[]
  staff                   Staff?
  adminOfCabinet          Cabinet?                 @relation("CabinetAdmin")

  @@index([email])
  @@index([googleId])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@map("email_verification_tokens")
}

model Patient {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  gender                   Gender
  phone                    String
  address                  String?
  city                     String?
  country                  String                    @default("Côte d'Ivoire")
  postalCode               String?
  latitude                 Float?
  longitude                Float?
  bloodType                String?
  allergies                String[]
  chronicConditions        String[]
  emergencyContactName     String?
  emergencyContactPhone    String?
  insuranceProvider        String?
  insuranceNumber          String?
  noShowCount              Int                       @default(0)
  penaltyUntil             DateTime?
  penaltyReason            String?
  warningCount             Int                       @default(0)
  lastWarningAt            DateTime?
  bannedAt                 DateTime?
  bannedById               String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  height                   Decimal?                  @db.Decimal(5, 2)
  surgicalOperations       String[]
  weight                   Decimal?                  @db.Decimal(5, 2)
  appointments             Appointment[]
  campaignRecipients       CampaignRecipient[]
  conversations            Conversation[]            @relation("PatientConversations")
  documents                Document[]
  medicalRecords           MedicalRecord[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments                 Payment[]
  prescriptions            Prescription[]
  reviews                  Review[]
  savedPaymentMethods      SavedPaymentMethod[]
  sharedRecords            SharedMedicalRecord[]
  teleconsultationSessions TeleconsultationSession[]
  vaccinationRecords       VaccinationRecord[]
  virtualQueueEntries      VirtualQueue[]

  @@index([userId])
  @@index([phone])
  @@index([city])
  @@index([latitude, longitude])
  @@map("patients")
}

model Practitioner {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  firstName                String
  lastName                 String
  title                    String
  phone                    String
  licenseNumber            String                    @unique
  licenseVerified          Boolean                   @default(false)
  licenseVerifiedAt        DateTime?
  yearsOfExperience        Int?
  bio                      String?
  clinicName               String?
  address                  String
  city                     String
  country                  String                    @default("Côte d'Ivoire")
  postalCode               String?
  latitude                 Float?
  longitude                Float?
  consultationDuration     Int                       @default(30)
  teleconsultationEnabled  Boolean                   @default(false)
  baseConsultationFee      Decimal                   @db.Decimal(10, 2)
  teleconsultationFee      Decimal?                  @db.Decimal(10, 2)
  acceptsInsurance         Boolean                   @default(false)
  averageRating            Decimal?                  @db.Decimal(3, 2)
  totalReviews             Int                       @default(0)
  acceptsNewPatients       Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  messagingEnabled         Boolean                   @default(false)
  backToBack               Boolean                   @default(false)
  breakBetweenSlots        Int                       @default(0)
  cancellationNotice       Int                       @default(24)
  emergencySlotsEnabled    Boolean                   @default(false)
  homeVisitEnabled         Boolean                   @default(false)
  maxBookingAdvance        Int                       @default(60)
  minBookingNotice         Int                       @default(60)
  newPatientMaxPerDay      Int                       @default(0)
  noShowThreshold          Int                       @default(3)
  noShowPenaltyDays        Int                       @default(30)
  noShowAutoBlock          Boolean                   @default(false)
  acceptedPaymentMethods   PaymentMethod[]
  bankInfo                 Json?
  emergencyFee             Decimal?                  @db.Decimal(10, 2)
  languages                String[]                  @default([])
  photoUrl                 String?
  isProfilePublic          Boolean                   @default(false)
  absences                 Absence[]
  appointments             Appointment[]
  availabilities           Availability[]
  blockedSlots             BlockedSlot[]
  conversations2           Conversation[]            @relation("Practitioner2Conversations")
  conversations            Conversation[]            @relation("PractitionerConversations")
  documents                Document[]
  medicalRecords           MedicalRecord[]
  payments                 Payment[]
  specialties              PractitionerSpecialty[]
  todos                    PractitionerTodo[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions            Prescription[]
  qualifications           Qualification[]
  reviews                  Review[]
  sharedRecordsAccess      SharedMedicalRecord[]
  staffMembers             Staff[]
  subscription             Subscription?
  teleconsultationSessions TeleconsultationSession[]
  virtualQueueEntries      VirtualQueue[]
  cabinets                 CabinetPractitioner[]
  cabinetInvitations       CabinetInvitation[]
  campaignRecipients       CampaignRecipient[]

  @@index([userId])
  @@index([licenseNumber])
  @@index([city])
  @@index([latitude, longitude])
  @@index([averageRating])
  @@map("practitioners")
}

model Specialty {
  id            String                  @id @default(cuid())
  name          String                  @unique
  description   String?
  icon          String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  practitioners PractitionerSpecialty[]

  @@map("specialties")
}

model PractitionerSpecialty {
  id             String       @id @default(cuid())
  practitionerId String
  specialtyId    String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, specialtyId])
  @@index([practitionerId])
  @@index([specialtyId])
  @@map("practitioner_specialties")
}

model Staff {
  id                    String        @id @default(cuid())
  userId                String        @unique
  practitionerId        String?
  cabinetId             String?
  firstName             String
  lastName              String
  phone                 String
  position              String
  canManageAppointments Boolean       @default(true)
  canViewMedicalRecords Boolean       @default(false)
  canManagePayments     Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  practitioner          Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  cabinet               Cabinet?      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([practitionerId])
  @@index([cabinetId])
  @@map("staff")
}

model Availability {
  id               String       @id @default(cuid())
  practitionerId   String
  dayOfWeek        DayOfWeek
  startTime        String
  endTime          String
  slotDuration     Int          @default(30)
  breakStartTime   String?
  breakEndTime     String?
  isEmergencySlot  Boolean      @default(false)
  isAdministrative Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([dayOfWeek])
  @@map("availabilities")
}

model Absence {
  id               String       @id @default(cuid())
  practitionerId   String
  startDate        DateTime
  endDate          DateTime
  reason           String?
  isRecurring      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  notifiedPatients Boolean      @default(false)
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([startDate, endDate])
  @@map("absences")
}

model BlockedSlot {
  id             String       @id @default(cuid())
  practitionerId String
  date           DateTime
  startTime      String
  endTime        String
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([date])
  @@map("blocked_slots")
}

model Appointment {
  id                      String                   @id @default(cuid())
  patientId               String
  practitionerId          String
  cabinetId               String?
  appointmentDate         DateTime
  startTime               String
  endTime                 String
  duration                Int
  type                    AppointmentType
  status                  AppointmentStatus        @default(PENDING)
  reason                  String?
  notes                   String?
  consultationFee         Decimal                  @db.Decimal(10, 2)
  cancelledAt             DateTime?
  cancelledBy             String?
  cancellationReason      String?
  markedAsNoShow          Boolean                  @default(false)
  noShowMarkedAt          DateTime?
  reminderSent24h         Boolean                  @default(false)
  reminderSent1h          Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  patient                 Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner            Practitioner             @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  cabinet                 Cabinet?                 @relation(fields: [cabinetId], references: [id])
  medicalRecord           MedicalRecord?
  payment                 Payment?
  teleconsultationSession TeleconsultationSession?

  @@index([patientId])
  @@index([practitionerId])
  @@index([cabinetId])
  @@index([appointmentDate])
  @@index([status])
  @@index([type])
  @@map("appointments")
}

model MedicalRecord {
  id               String                @id @default(cuid())
  appointmentId    String                @unique
  patientId        String
  practitionerId   String
  chiefComplaint   String?
  historyOfIllness String?
  examination      String?
  diagnosis        String?
  treatmentPlan    String?
  bloodPressure    String?
  heartRate        Int?
  temperature      Decimal?              @db.Decimal(4, 1)
  weight           Decimal?              @db.Decimal(5, 2)
  height           Decimal?              @db.Decimal(5, 2)
  additionalData   Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  documents        Document[]
  appointment      Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient          Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner     Practitioner          @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  prescriptions    Prescription[]
  sharedWith       SharedMedicalRecord[]

  @@index([patientId])
  @@index([practitionerId])
  @@index([appointmentId])
  @@map("medical_records")
}

model SharedMedicalRecord {
  id              String        @id @default(cuid())
  medicalRecordId String
  patientId       String
  practitionerId  String
  canView         Boolean       @default(true)
  canEdit         Boolean       @default(false)
  sharedAt        DateTime      @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([medicalRecordId, practitionerId])
  @@index([medicalRecordId])
  @@index([practitionerId])
  @@index([patientId])
  @@map("shared_medical_records")
}

model Prescription {
  id              String        @id @default(cuid())
  medicalRecordId String
  patientId       String
  practitionerId  String
  medications     Json
  issuedDate      DateTime      @default(now())
  validUntil      DateTime?
  signature       String?
  signedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([practitionerId])
  @@index([medicalRecordId])
  @@map("prescriptions")
}

model Document {
  id              String         @id @default(cuid())
  medicalRecordId String?
  practitionerId  String?
  type            DocumentType
  title           String
  description     String?
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  isEncrypted     Boolean        @default(true)
  encryptionKey   String?
  uploadedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  patientId       String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient         Patient?       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner?  @relation(fields: [practitionerId], references: [id])

  @@index([medicalRecordId])
  @@index([practitionerId])
  @@index([patientId])
  @@index([type])
  @@map("documents")
}

model Conversation {
  id                 String                     @id @default(cuid())
  patientId          String?
  practitionerId     String
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  type               ConversationType           @default(PATIENT_PRACTITIONER)
  practitioner2Id    String?
  userSettings       ConversationUserSettings[]
  patient            Patient?                   @relation("PatientConversations", fields: [patientId], references: [id], onDelete: Cascade)
  practitioner2      Practitioner?              @relation("Practitioner2Conversations", fields: [practitioner2Id], references: [id], onDelete: Cascade)
  practitioner       Practitioner               @relation("PractitionerConversations", fields: [practitionerId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([patientId, practitionerId])
  @@index([patientId])
  @@index([practitionerId])
  @@index([practitioner2Id])
  @@index([lastMessageAt])
  @@index([type])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  content        String
  attachments    Json?
  status         MessageStatus @default(SENT)
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversationId String
  senderUserId   String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderUserId])
  @@index([createdAt])
  @@map("messages")
}

model Payment {
  id              String        @id @default(cuid())
  appointmentId   String        @unique
  patientId       String
  practitionerId  String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("XOF")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  mobileMoneyRef  String?       @unique
  paypalOrderId   String?       @unique
  invoiceNumber   String        @unique
  invoiceUrl      String?
  refundedAmount  Decimal?      @db.Decimal(10, 2)
  refundedAt      DateTime?
  refundReason    String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoice         Invoice?
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([practitionerId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([invoiceNumber])
  @@map("payments")
}

model SavedPaymentMethod {
  id             String        @id @default(cuid())
  patientId      String
  type           PaymentMethod
  label          String
  isDefault      Boolean       @default(false)
  cardLast4      String?
  cardBrand      String?
  cardExpMonth   Int?
  cardExpYear    Int?
  mobileOperator String?
  mobileNumber   String?
  isVerified     Boolean       @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("saved_payment_methods")
}

model Notification {
  id             String              @id @default(cuid())
  userId         String
  type           NotificationType
  channel        NotificationChannel
  title          String
  message        String
  metadata       Json?
  sent           Boolean             @default(false)
  sentAt         DateTime?
  read           Boolean             @default(false)
  readAt         DateTime?
  deliveryStatus String?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([sent])
  @@index([read])
  @@map("notifications")
}

model Review {
  id             String       @id @default(cuid())
  practitionerId String
  patientId      String
  appointmentId  String       @unique
  rating         Int
  comment        String?
  response       String?
  respondedAt    DateTime?
  isPublished    Boolean      @default(true)
  moderatedAt    DateTime?
  moderatedBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([patientId])
  @@index([rating])
  @@map("reviews")
}

model Campaign {
  id                   String              @id @default(cuid())
  title                String
  description          String
  message              String
  messageType          String              @default("INFO")
  status               CampaignStatus      @default(DRAFT)
  targetType           CampaignTargetType
  targetUserTypes      String[]            @default([])
  targetAgeMin         Int?
  targetAgeMax         Int?
  targetLocations      String[]
  targetPathologies    String[]
  targetRegisteredFrom DateTime?
  targetRegisteredTo   DateTime?
  channels             String[]            @default(["EMAIL"])
  scheduledAt          DateTime?
  sentAt               DateTime?
  totalRecipients      Int                 @default(0)
  sentCount            Int                 @default(0)
  failedCount          Int                 @default(0)
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  recipients           CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id             String        @id @default(cuid())
  campaignId     String
  patientId      String?
  practitionerId String?
  email          String
  sent           Boolean       @default(false)
  sentAt         DateTime?
  delivered      Boolean       @default(false)
  deliveredAt    DateTime?
  opened         Boolean       @default(false)
  openedAt       DateTime?
  error          String?
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([patientId])
  @@index([practitionerId])
  @@map("campaign_recipients")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  oldValues  Json?
  newValues  Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Consent {
  id          String    @id @default(cuid())
  userId      String
  consentType String
  version     String
  accepted    Boolean   @default(true)
  acceptedAt  DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
  @@map("consents")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Qualification {
  id               String       @id @default(cuid())
  practitionerId   String
  title            String
  institution      String
  yearObtained     Int
  country          String       @default("Côte d'Ivoire")
  documentPath     String?
  documentFileName String?
  isVerified       Boolean      @default(false)
  verifiedAt       DateTime?
  verifiedBy       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([isVerified])
  @@map("qualifications")
}

model TeleconsultationSession {
  id                   String                 @id @default(cuid())
  appointmentId        String                 @unique
  patientId            String
  practitionerId       String
  roomId               String                 @unique
  roomName             String
  status               TeleconsultationStatus @default(SCHEDULED)
  scheduledAt          DateTime
  startedAt            DateTime?
  endedAt              DateTime?
  duration             Int?
  patientJoinedAt      DateTime?
  practitionerJoinedAt DateTime?
  waitingRoomTime      Int?
  recordingEnabled     Boolean                @default(false)
  recordingConsent     Boolean                @default(false)
  recordingPath        String?
  connectionQuality    String?
  errorMessage         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  auditLog             Json?
  chatMessages         Json?
  noShowMarkedBy       String?
  screenSharingUsed    Boolean                @default(false)
  appointment          Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner         Practitioner           @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([practitionerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("teleconsultation_sessions")
}

model VirtualQueue {
  id                   String       @id @default(cuid())
  patientId            String
  practitionerId       String
  appointmentId        String?
  position             Int
  status               QueueStatus  @default(WAITING)
  checkInTime          DateTime     @default(now())
  calledTime           DateTime?
  completedTime        DateTime?
  estimatedWaitMinutes Int?
  actualWaitMinutes    Int?
  priority             Int          @default(0)
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  patient              Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner         Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([patientId])
  @@index([status])
  @@index([position])
  @@map("virtual_queue")
}

model DataExportRequest {
  id           String            @id @default(cuid())
  userId       String
  status       DataRequestStatus @default(PENDING)
  requestedAt  DateTime          @default(now())
  processedAt  DateTime?
  completedAt  DateTime?
  filePath     String?
  fileSize     Int?
  expiresAt    DateTime?
  downloadedAt DateTime?
  errorMessage String?
  ipAddress    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_export_requests")
}

model DataDeletionRequest {
  id                  String            @id @default(cuid())
  userId              String
  status              DataRequestStatus @default(PENDING)
  reason              String?
  requestedAt         DateTime          @default(now())
  scheduledDeletionAt DateTime?
  processedAt         DateTime?
  completedAt         DateTime?
  confirmedAt         DateTime?
  confirmationToken   String?           @unique
  errorMessage        String?
  ipAddress           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_deletion_requests")
}

model Invoice {
  id                String    @id @default(cuid())
  paymentId         String    @unique
  invoiceNumber     String    @unique
  invoiceDate       DateTime  @default(now())
  dueDate           DateTime?
  subtotal          Decimal   @db.Decimal(10, 2)
  taxRate           Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)
  currency          String    @default("XOF")
  items             Json
  billedToName      String
  billedToAddress   String?
  billedToEmail     String?
  billedToPhone     String?
  billedFromName    String
  billedFromAddress String?
  billedFromLicense String?
  pdfPath           String?
  pdfGeneratedAt    DateTime?
  exportedAt        DateTime?
  exportBatchId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([exportBatchId])
  @@map("invoices")
}

model VaccinationRecord {
  id              String    @id @default(cuid())
  patientId       String
  vaccineName     String
  vaccineType     String?
  manufacturer    String?
  batchNumber     String?
  doseNumber      Int       @default(1)
  administeredAt  DateTime
  administeredBy  String?
  location        String?
  nextDoseDate    DateTime?
  reminderEnabled Boolean   @default(true)
  reminderSentAt  DateTime?
  sideEffects     String?
  certificatePath String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([vaccineName])
  @@index([nextDoseDate])
  @@map("vaccination_records")
}

model ContactRequest {
  id                   String               @id @default(cuid())
  requestType          ContactRequestType
  status               ContactRequestStatus @default(PENDING)
  firstName            String
  lastName             String
  email                String
  phone                String
  postalCode           String?
  specialty            String?
  adminNotes           String?
  processedBy          String?
  processedAt          DateTime?
  createdUserId        String?
  rejectionReason      String?
  // Practitioner-specific
  identityDocumentPath String?
  diplomaPath          String?
  orderAttestationPath String?
  orderNumber          String?
  clinicAddress        String?
  // Cabinet-specific
  cabinetName          String?
  cabinetAddress       String?
  cabinetRccm          String?
  adminContactName     String?
  adminContactEmail    String?
  adminContactPhone    String?
  cabinetRegDocPath    String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([email])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
  @@map("contact_requests")
}

model Cabinet {
  id                  String                @id @default(cuid())
  name                String
  address             String
  city                String?
  country             String                @default("Côte d'Ivoire")
  phone               String?
  rccm                String?
  adminUserId         String?               @unique
  adminContactName    String
  adminContactEmail   String
  adminContactPhone   String
  registrationDocPath String?
  openHours           Json?
  latitude            Float?
  longitude           Float?
  isVerified          Boolean               @default(false)
  verifiedAt          DateTime?
  contactRequestId    String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  practitioners       CabinetPractitioner[]
  staffMembers        Staff[]
  invitations         CabinetInvitation[]
  appointments        Appointment[]
  adminUser           User?                 @relation("CabinetAdmin", fields: [adminUserId], references: [id])

  @@index([name])
  @@index([adminUserId])
  @@map("cabinets")
}

model CabinetPractitioner {
  id             String       @id @default(cuid())
  cabinetId      String
  practitionerId String
  isPaused       Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  cabinet        Cabinet      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([cabinetId, practitionerId])
  @@index([cabinetId])
  @@index([practitionerId])
  @@map("cabinet_practitioners")
}

model CabinetInvitation {
  id             String       @id @default(cuid())
  cabinetId      String
  practitionerId String
  email          String
  status         String       @default("PENDING")
  invitedAt      DateTime     @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime
  cabinet        Cabinet      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([cabinetId, practitionerId])
  @@index([cabinetId])
  @@index([practitionerId])
  @@index([email])
  @@map("cabinet_invitations")
}

model PractitionerTodo {
  id             String       @id @default(cuid())
  practitionerId String
  title          String
  completed      Boolean      @default(false)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([completed])
  @@map("practitioner_todos")
}

model ConversationUserSettings {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  emailMuted     Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_user_settings")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  smsNotifications     Boolean  @default(false)
  appointmentReminders Boolean  @default(true)
  newMessages          Boolean  @default(true)
  healthTipsAndNews    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model Subscription {
  id                String       @id @default(cuid())
  practitionerId    String       @unique
  plan              String       @default("PREMIUM")
  status            String       @default("ACTIVE")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@map("subscriptions")
}

