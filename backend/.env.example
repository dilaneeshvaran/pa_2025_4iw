# server
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
BACKEND_NODE_ENV=development
BACKEND_APP_URL=http://localhost:3001

# db
BACKEND_DATABASE_URL=postgresql://admin:admin@localhost:5432/medicote?schema=public

# postgres
BACKEND_POSTGRES_USER=
BACKEND_POSTGRES_PASSWORD=
BACKEND_POSTGRES_DB=
BACKEND_POSTGRES_PORT=

# jwt
BACKEND_JWT_SECRET=
BACKEND_JWT_REFRESH_SECRET=
BACKEND_JWT_EXPIRES_IN=15m
BACKEND_JWT_REFRESH_EXPIRES_IN=7d

# encryption
BACKEND_ENCRYPTION_KEY= # 64 char hex string ici

# redis (for sessions and caching)
BACKEND_REDIS_URL=redis://localhost:6379

# email (smtp)
BACKEND_SMTP_HOST=
BACKEND_SMTP_PORT=
BACKEND_SMTP_USER=
BACKEND_SMTP_PASS=""
BACKEND_SMTP_FROM=

# google oauth
BACKEND_GOOGLE_CLIENT_ID=
BACKEND_GOOGLE_CLIENT_SECRET=''
BACKEND_GOOGLE_CALLBACK_URL=

# seed data secrets
BACKEND_ADMIN_PASSWORD=
BACKEND_PATIENT_PASSWORD=
BACKEND_PRACTITIONER_PASSWORD=
BACKEND_STAFF_PASSWORD=
BACKEND_SEED_TOTP_SECRET=

# sms (twilio)
BACKEND_TWILIO_ACCOUNT_SID=
BACKEND_TWILIO_AUTH_TOKEN=
BACKEND_TWILIO_PHONE_NUMBER=

# stripe
BACKEND_STRIPE_SECRET_KEY=
BACKEND_STRIPE_WEBHOOK_SECRET=

# frontend url (for cors)
BACKEND_FRONTEND_URL=http://localhost:3000

# file storage
BACKEND_STORAGE_TYPE=local # or 's3'
BACKEND_UPLOAD_DIR=./uploads
BACKEND_MAX_FILE_SIZE=10485760 # 10MB

# rate limiting
BACKEND_RATE_LIMIT_MAX=100
BACKEND_RATE_LIMIT_TIME_WINDOW=60000 # 1 minute

