{
  "name": "medicote-monorepo",
  "version": "1.0.0",
  "description": "Medicote - Medical appointment and consultation platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run preview --workspace=frontend",
    "install:all": "npm install",
    "seed:dev": "npm run seed:dev --workspace=backend"
  },
  "keywords": [
    "medicote",
    "medical",
    "appointments",
    "telemedicine"
  ],
  "author": "Dilan EESHVARAN, AKA Kassi Joel Emmanuel, Sylvain ANTIN, Alix Sylvani",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
