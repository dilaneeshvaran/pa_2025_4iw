PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://admin:admin@localhost:5432/medicote?schema=public

# postgres 
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# jwt 
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# encrypt
ENCRYPTION_KEY=

# Redis (for sessions and caching)
REDIS_URL=redis://localhost:6379

# email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=""
SMTP_FROM=

# google oauth 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=''
GOOGLE_CALLBACK_URL=

# seed data secrets
ADMIN_PASSWORD=
PATIENT_PASSWORD=
PRACTITIONER_PASSWORD=
STAFF_PASSWORD=
SEED_TOTP_SECRET=


# sms 
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# frontend url (for cors)
FRONTEND_URL=http://localhost:3001

# file storage
STORAGE_TYPE=local # or 's3'
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760 # 10MB

# rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000 # 1 minute