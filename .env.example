# --- Docker image tags -------------------------------------------------------
BACKEND_IMAGE=ghcr.io/dilaneeshvaran/pa_2025_4iw-backend:latest
FRONTEND_IMAGE=ghcr.io/dilaneeshvaran/pa_2025_4iw-frontend:latest
NGINX_IMAGE=ghcr.io/dilaneeshvaran/pa_2025_4iw-nginx:latest

# --- Public URLs -------------------------------------------------------------
PUBLIC_FRONTEND_URL=https://medicote.me
PUBLIC_BACKEND_URL=https://medicote.me
# Match the Nginx location blocks -- do not change without rebuilding images
PUBLIC_API_BASE=/api
PUBLIC_UMAMI_URL=/umami

# --- PostgreSQL --------------------------------------------------------------
BACKEND_POSTGRES_USER=medicote
BACKEND_POSTGRES_DB=medicote
BACKEND_POSTGRES_PORT=5432
BACKEND_POSTGRES_PASSWORD=change_me_strong_password

# --- JWT ---------------------------------------------------------------------
BACKEND_JWT_REFRESH_SECRET=change_me_64_char_hex_string
BACKEND_JWT_EXPIRES_IN=15m
BACKEND_JWT_REFRESH_EXPIRES_IN=7d
BACKEND_ENCRYPTION_KEY=change_me_64_char_hex_string

# --- Email (Resend) ----------------------------------------------------------
BACKEND_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
BACKEND_EMAIL_FROM=MediCote <noreply@medicote.me>
BACKEND_MESSAGE_EMAIL_DELAY_MS=0

# --- Stripe ------------------------------------------------------------------
BACKEND_STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
BACKEND_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
FRONTEND_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# --- Google OAuth ------------------------------------------------------------
BACKEND_GOOGLE_CLIENT_ID=
BACKEND_GOOGLE_CLIENT_SECRET=
BACKEND_GOOGLE_CALLBACK_URL=https://medicote.me/api/auth/google/callback
FRONTEND_GOOGLE_CLIENT_ID=

# --- Twilio SMS --------------------------------------------------------------
BACKEND_TWILIO_ACCOUNT_SID=
BACKEND_TWILIO_AUTH_TOKEN=
BACKEND_TWILIO_PHONE_NUMBER=

# --- File storage ------------------------------------------------------------
BACKEND_STORAGE_TYPE=local
BACKEND_MAX_FILE_SIZE=10485760

# --- Rate limiting -----------------------------------------------------------
BACKEND_RATE_LIMIT_MAX=100
BACKEND_RATE_LIMIT_TIME_WINDOW=60000

# --- Umami Analytics ---------------------------------------------------------
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change_me_strong_password
UMAMI_APP_SECRET=change_me_at_least_32_characters_secret
UMAMI_WEBSITE_ID=
UMAMI_ENABLED=true
